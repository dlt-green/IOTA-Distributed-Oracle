# Wallet signing is performed by the connected user wallet. No private keys belong here.
# Canonical external HTTPS origin. Set this explicitly behind a reverse proxy.
WEBVIEW_PUBLIC_ORIGIN=
# Optional additional browser origins (comma-separated, exact origins).
WEBVIEW_ALLOWED_ORIGINS=
# Exact reverse-proxy IPs/CIDRs, only if needed for per-client-IP rate limiting.
# Empty means no forwarded client-IP headers are trusted.
WEBVIEW_TRUSTED_PROXIES=

# Public read/SSE and upstream budgets, per process. Invalid positive limits fail startup.
WEBVIEW_READS_PER_MINUTE=240
WEBVIEW_READ_CONCURRENCY_PER_IP=8
WEBVIEW_READ_CONCURRENCY=64
# Global active preparation subprocesses per Webview instance (1-32).
WEBVIEW_PREPARATION_CONCURRENCY=4
WEBVIEW_STREAMS_PER_IP=4
WEBVIEW_STREAMS=64
WEBVIEW_STREAM_MAX_AGE_MS=300000
WEBVIEW_UPSTREAM_TIMEOUT_MS=15000
WEBVIEW_UPSTREAM_CONCURRENCY=32
WEBVIEW_UPSTREAM_PER_MINUTE=1200
WEBVIEW_UPSTREAM_MAX_BYTES=10000000
# Historical metrics use a sub-budget within the global limits (capped at 10% of request rate).
WEBVIEW_HISTORY_PER_MINUTE=60
WEBVIEW_HISTORY_PAGES_PER_BATCH=2
# JSON-lines audit file. MAX_FILES includes the current file (defaults: 5 x 10 MB).
WEBVIEW_AUDIT_ENABLED=true
WEBVIEW_AUDIT_FILE=./logs/audit.log
WEBVIEW_AUDIT_MAX_FILE_MB=10
WEBVIEW_AUDIT_MAX_FILES=5
# Keep an additional stdout / docker logs copy; file errors always fall back to stdout.
WEBVIEW_AUDIT_STDOUT=true
# Use a stable random salt for cross-restart IP correlation.
WEBVIEW_AUDIT_IP_SALT=
# Optional task HTTP destination restrictions. Empty preserves public HTTP(S) sources.
# Exact hosts, or *.example.com for subdomains only. Redirect targets must also match.
TASK_HTTP_ALLOWED_HOSTS=
TASK_HTTP_ALLOWED_PORTS=
PORT=8787

# Optional base EULA override. By default the server reads the canonical EULA from the project GitHub repo.
# The webview appends public/EULA_NODE_OPERATOR_TERMS.md from the local node operator checkout.
# For private repositories, set EULA_SOURCE_TOKEN server-side only.
EULA_SOURCE_URL=
EULA_SOURCE_TOKEN=

# Docker / Traefik host.
TRAEFIK_ORACLE_HOST=oracle.objectid.io

# Network-specific config for network switching (devnet/testnet/mainnet).
DEVNET_IOTA_RPC_URL=https://api.devnet.iota.cafe
DEVNET_IOTA_GRAPHQL_URL=https://graphql.devnet.iota.cafe
