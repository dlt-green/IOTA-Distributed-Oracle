
# Testnet v2.0.15: IDs below match the corrected fresh publication.
# Existing operators: use update.sh to migrate all IDs automatically.
# See docs/TESTNET_REGISTRATION_MIGRATION.md. Preserve existing keys/cap IDs.
NODE_1_NETWORK=testnet
NODE_1_AUTO_REGISTER=true
NODE_1_AUTO_UNREGISTER=true
NODE_1_REGISTER_MODE=prod
NODE_1_ORACLE_HTTP_INSECURE_TLS=false
NODE_1_PRIVATEKEY=
NODE_1_DELEGATED_CONTROLLER_CAP_ID=<YOUR NODE DELEGATED CONTROLLERCAP>

# Network-specific oracle config.
DEVNET_IOTA_RPC_URL=https://api.devnet.iota.cafe
