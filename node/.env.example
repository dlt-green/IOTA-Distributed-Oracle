DEVNET_ORACLE_NODE_REGISTRY_ID=0x7840e54199ac471e28a864790c5157ce2a0b73ba71641bd2e74caf5efa9595c9
DEVNET_ORACLE_TASK_SCHEDULER_QUEUE_ID=0xef7fc995fb5b2d95577631c7221be1dfb004529b99fe60502a0cc437ec278b16
DEVNET_ORACLE_TASK_REGISTRY_ID=0x9b877cdc0efd16e2f1651025d19578023823b04754e9c136908265b1586b0942

TESTNET_IOTA_RPC_URL=https://api.testnet.iota.cafe
TESTNET_ORACLE_VALIDATOR_CAPS_PACKAGE_ID=0xa20f8117eccd5d003991d3fe9fa2a440841a74d96017e3e6af0024b524d9c09b
TESTNET_ORACLE_TASKS_PACKAGE_ID=0x92a24b746f7b5e2ef8f6edd1d3ee39ed2e0c1e460d7bdfcd141833cd3cdf70ae
TESTNET_ORACLE_SYSTEM_PACKAGE_ID=0x5e118216b230f7c76a9edb262c60ccb50bb6b62f5e73bb0a71a356ffcc45939b
TESTNET_ORACLE_STATE_ID=0x4a38671c43b05cd3cd68f9c03bda7ca3d7eca93d213d8c6af44f1cf152b12609
TESTNET_ORACLE_TREASURY_ID=0xb6a5001382d15d0cbc71dc0b4254847809d1d2c65406641fa577d39392a909ef
TESTNET_CONTROLLER_CAP_ID=0x935591dc6a5b6a8caa8019698967f27be92ffe0f38174b37f5076b981d67f021
TESTNET_ORACLE_NODE_REGISTRY_ID=0x3c31915fdc3ec438b28fc15aaea7f980be2291546ef6d3aaa2960b262f6b2b73
TESTNET_ORACLE_TASK_SCHEDULER_QUEUE_ID=0x3db95fc16ccd1b5050464e003ea38680e73e08234e73a229b8f3e1f87ec22a83
TESTNET_ORACLE_TASK_REGISTRY_ID=0x99bf14b97b2c83400ccd3eb81ea145180a070066bab6ce2522aa2c16d4213473

MAINNET_IOTA_RPC_URL=https://api.mainnet.iota.cafe
MAINNET_ORACLE_VALIDATOR_CAPS_PACKAGE_ID=
MAINNET_ORACLE_TASKS_PACKAGE_ID=
MAINNET_ORACLE_SYSTEM_PACKAGE_ID=
MAINNET_ORACLE_STATE_ID=
MAINNET_ORACLE_TREASURY_ID=
MAINNET_CONTROLLER_CAP_ID=
MAINNET_ORACLE_NODE_REGISTRY_ID=
MAINNET_ORACLE_TASK_SCHEDULER_QUEUE_ID=
MAINNET_ORACLE_TASK_REGISTRY_ID=

# System objects (defaults are usually correct)
IOTA_SYSTEM_STATE_ID=0x5
IOTA_CLOCK_ID=0x6

# Polling
EVENT_POLL_MS=1200

# Gas
GAS_BUDGET=50000000
GAS_BUDGET_COMMIT_SIG=30000000
GAS_BUDGET_REVEAL=30000000
GAS_BUDGET_PARTIAL_SIG=30000000
GAS_BUDGET_NODE_COMMIT=40000000
GAS_BUDGET_FINALIZE=250000000
GAS_BUDGET_REQUEST_DATA=20000000
GAS_BUDGET_SUBMIT_DATA=30000000
GAS_BUDGET_CLOSE_DATA=20000000

# Consensus policy
LEADER_ONLY_FINALIZE=true
NON_LEADER_FINALIZE_DELAY_MS=15000

# Timing (ms)
WAIT_REVEAL_MS=90000
WAIT_REVEAL_POLL_MS=1500
REVEAL_COLLECT_WAIT_MS=40000
REVEAL_COLLECT_POLL_MS=1500
PARTIAL_COLLECT_WAIT_MS=60000
PARTIAL_COLLECT_POLL_MS=2000
FINALIZE_WAIT_MS=60000
WAIT_MATCHING_NODE_COMMITS_MS=20000
WAIT_MATCHING_NODE_COMMITS_POLL_MS=1200
FINALIZE_POLL_MS=2500

# STORAGE fetch limits (content is persisted on IPFS only)
STORAGE_FETCH_TIMEOUT_MS=30000
STORAGE_MAX_DOWNLOAD_BYTES=25000000


# LLM task execution (OpenAI-compatible Chat Completions endpoint)
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
# Optional fallback models, comma-separated, tried left-to-right when the
# primary model fails with a retryable error (429, 500, 502, 503, timeout).
# Example: if LLM_MODEL=a and LLM_MODEL_FALLBACK=b,c the order is a -> b -> c.
# Leave empty to disable fallback.
# Example: LLM_MODEL_FALLBACK=anthropic/claude-haiku-4-5-20251001,google/gemini-2.5-flash-lite
LLM_MODEL_FALLBACK=
# Optional extra HTTP headers for self-hosted or proxied gateways, as JSON object.
# Example: {"Helicone-Auth":"Bearer ..."}
LLM_API_HEADERS_JSON=
# Optional provider-specific plugins array, as JSON.
# Required for OpenRouter to handle PDF inputs and JSON healing.
# Leave empty when using OpenAI directly.
# Example: [{"id":"file-parser","pdf":{"engine":"native"}},{"id":"response-healing"}]
LLM_PLUGINS_JSON=
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=400
LLM_MAX_INPUT_CHARS=20000

# PDF fetch/extraction for LLM tasks
LLM_PDF_FETCH_TIMEOUT_MS=30000
LLM_PDF_MAX_DOWNLOAD_BYTES=25000000
LLM_PDFTOTEXT_BIN=pdftotext
LLM_PDFTOTEXT_MAX_BUFFER_BYTES=10000000

# IPFS publication for STORAGE tasks
IPFS_ENABLED=true
IPFS_API_URL=
IPFS_PIN=true
IPFS_CID_VERSION=1
IPFS_BEARER_TOKEN=
IPFS_BASIC_AUTH_USER=
IPFS_BASIC_AUTH_PASS=
IPFS_API_KEY=
IPFS_API_SECRET=
REGISTER_MODE=prod
IOTA_NETWORK=testnet
IOTA_RPC_URL=https://api.testnet.iota.cafe
IOTA_FAUCET_URL=https://faucet.testnet.iota.cafe/gas
ORACLE_TASKS_PACKAGE_ID=0x92a24b746f7b5e2ef8f6edd1d3ee39ed2e0c1e460d7bdfcd141833cd3cdf70ae
ORACLE_SYSTEM_PACKAGE_ID=0x5e118216b230f7c76a9edb262c60ccb50bb6b62f5e73bb0a71a356ffcc45939b
ORACLE_STATE_ID=0x4a38671c43b05cd3cd68f9c03bda7ca3d7eca93d213d8c6af44f1cf152b12609
ORACLE_TREASURY_ID=0xb6a5001382d15d0cbc71dc0b4254847809d1d2c65406641fa577d39392a909ef
CONTROLLER_CAP_ID=0x935591dc6a5b6a8caa8019698967f27be92ffe0f38174b37f5076b981d67f021
ORACLE_TASK_SCHEDULER_QUEUE_ID=0x3db95fc16ccd1b5050464e003ea38680e73e08234e73a229b8f3e1f87ec22a83
ORACLE_TASK_REGISTRY_ID=0x99bf14b97b2c83400ccd3eb81ea145180a070066bab6ce2522aa2c16d4213473
ORACLE_NODE_REGISTRY_ID=0x3c31915fdc3ec438b28fc15aaea7f980be2291546ef6d3aaa2960b262f6b2b73
ORACLE_VALIDATOR_CAPS_PACKAGE_ID=0xa20f8117eccd5d003991d3fe9fa2a440841a74d96017e3e6af0024b524d9c09b

# Monitor: /health is minimal; /status requires a random token of at least 32 characters.
# Compose binds container port 9080 only to host loopback.
MONITOR_AUTH_TOKEN=

# Optional additional task destination denials (domain and all its subdomains).
# Private/special IP blocking is mandatory and cannot be disabled here.
TASK_HTTP_DENIED_HOSTS=

# Optional restrictions for task HTTP destinations (never allow private/special IPs).
# Exact host or *.example.com (subdomains only); redirects must also match.
TASK_HTTP_ALLOWED_HOSTS=
TASK_HTTP_ALLOWED_PORTS=
AUTO_REGISTER=true
